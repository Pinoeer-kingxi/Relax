#
# Machine-local config for the DeepEyes V2 agentic example.
#
# Setup:
#   cp env.sh.example env.sh
#   # edit env.sh — at minimum set DATA_DIR; everything else is optional
#
# env.sh is gitignored. The launcher scripts + prepare.sh + harness all
# auto-source it. Put per-host paths / endpoints / proxies / mirrors here so
# they don't end up in committed code.

# ============================================================================
# REQUIRED
# ============================================================================

# Workspace root. scripts/prepare.sh lays out:
#   ${DATA_DIR}/sif/deepeyes_v2_kernel.sif
#   ${DATA_DIR}/data/{raw/,perception_all_*.parquet,reason.parquet,…,smoke.parquet}
export DATA_DIR=/path/to/your/workspace/deepeyes-v2

# Full training additionally requires a model root containing both exact
# directories below and a writable checkpoint/output directory:
#   ${MODEL_DIR}/Qwen3.6-35B-A3B/
#   ${MODEL_DIR}/Qwen2.5-1.5B-Instruct/
export MODEL_DIR=/path/to/your/models
export SAVE_DIR=/path/to/your/checkpoints/deepeyes-v2

# Exact Relax training environment pulled from the digest pinned in
# docs/search-e2e-resources.md. Its adjacent .oci-digest provenance marker is
# required by scripts/preflight_training.py.
export RELAX_TRAINING_IMAGE_PATH=/path/to/images/relaxrl-pinned.sif

# Optional compatibility override for a host whose mounted Python user site
# shadows the image's cuda-python package. Install a CUDA-12.9-compatible
# cuda-python into this directory, then expose it inside Apptainer. Leave these
# unset when the pinned image imports cuda.bindings.driver/runtime directly.
# export RELAX_CUDA_PYTHON_OVERRIDE=/path/to/python-overrides/cuda-python-12.9.1
# export APPTAINERENV_PYTHONPATH="${RELAX_CUDA_PYTHON_OVERRIDE}"
# export APPTAINERENV_PYTHONNOUSERSITE=1

# Host/topology-specific NCCL fallback. Only enable after a real multi-GPU
# collective fails with the default transport; it trades bandwidth for
# stability on hosts where peer-to-peer or IB setup is incompatible.
# export NCCL_P2P_DISABLE=1
# export NCCL_IB_DISABLE=1

# Node-local host-side agent environment prepared by scripts/prepare_app_env.sh.
export DEEPEYES_V2_APP_ENV_ROOT=/tmp/deepeyes-v2-app-env

# ============================================================================
# Required for scripts/smoke.sh + scripts/run_single_session.py
# ============================================================================

# Chat-completions endpoint. Any OpenAI-compatible host works (SGLang, vLLM, MaaS, …).
# export OPENAI_BASE_URL=http://your-sglang-host:30000/v1
# export OPENAI_API_KEY=dummy            # SGLang doesn't validate
# Model id sent to the endpoint. Default "model" works for SGLang (model arg ignored);
# set to the real model name for MaaS/vLLM/etc.
# export OPENAI_MODEL=qwen3-vl-235b-a22b-instruct

# ============================================================================
# Optional — pluggable text web search
# ============================================================================

# Default is deterministic offline mock search. Select one of the complete
# examples under configs/search/ for a real backend:
# export DEEPEYES_V2_WEB_SEARCH_CONFIG=/absolute/path/to/configs/search/retriever.yaml
# export DEEPEYES_V2_WEB_SEARCH_CONFIG=/absolute/path/to/configs/search/external-tavily.yaml

# Whitelisted scalar overrides. An explicitly empty value is a configuration
# error, so leave an override unset when it is not needed.
# export DEEPEYES_V2_WEB_SEARCH_BACKEND=external
# export DEEPEYES_V2_WEB_SEARCH_URL=https://search.example.com/v1/search
# export DEEPEYES_V2_WEB_SEARCH_TOP_K=5
# export DEEPEYES_V2_WEB_SEARCH_TIMEOUT_S=10
# export DEEPEYES_V2_WEB_SEARCH_MAX_RETRIES=2

# The Tavily example reads this variable at request time. Never commit its
# value. Cluster launch JSON deliberately does not copy this secret; provision
# it in each worker environment, or use external.auth.file on protected shared
# storage and put only that file path in the search config.
# export TAVILY_API_KEY=...

# Optional complete agent YAML, useful when a different model family requires
# different stop-token IDs or turn limits.
# export DEEPEYES_V2_AGENT_CONFIG=/absolute/path/to/deepeyes_v2_config.yaml

# ============================================================================
# Optional — outbound HTTPS proxy for scripts/prepare.sh HF downloads
# ============================================================================
# Set if huggingface.co is unreachable directly from this host.
# export HF_HTTP_PROXY=http://your.proxy.host:3128
# export HF_NO_PROXY=127.0.0.1,localhost,your.internal.hosts

# ============================================================================
# Optional — SIF build mirrors (only if docker hub + pypi.org are blocked)
# ============================================================================
# Override the base docker image fetched at build time.
# export BOOTSTRAP_FROM_IMAGE=your.docker.mirror/library/python:3.11-slim

# Override pip's index inside the SIF build.
# export BOOTSTRAP_PIP_INDEX_URL=http://your.pypi.mirror/simple
# export BOOTSTRAP_PIP_TRUSTED_HOST=your.pypi.mirror

# ============================================================================
# Optional — HuggingFace endpoint
# ============================================================================
# Default is https://huggingface.co. Override to a mirror only if you've
# verified the mirror serves the full dataset (some mirrors 308-redirect
# large files back to upstream, which huggingface_hub refuses).
# export HF_ENDPOINT=https://your.hf.mirror
